{
  "name": "fake-git-history",
  "version": "1.9.2",
  "description": "A local web studio and CLI for designing and generating Git activity.",
  "bin": "src/cli.js",
  "main": "src/cli.js",
  "files": [
    "src",
    "web",
    "dist",
    "index.html",
    "vite.config.mjs"
  ],
  "repository": "git@github.com:artiebits/fake-git-history.git",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "npm run build && node src/server.js",
    "lint": "prettier --write 'src/**/*.js'",
    "start:server": "node src/server.js",
    "cli": "node src/cli.js",
    "dev": "node src/dev.js",
    "build": "vite build",
    "test": "node --test"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*src/**/*.{js,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "boxen": "^4.2.0",
    "chalk": "4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "1.30.1",
    "lucide-react": "^1.43.0",
    "meow": "^5.0.0",
    "ora": "5.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "husky": "^4.3.0",
    "lint-staged": "^10.4.0",
    "prettier": "^1.19.1",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6"
  },
  "keywords": [
    "git",
    "github",
    "commit-history",
    "git-activity",
    "contributions-calendar",
    "contribution-graph",
    "contributions"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
